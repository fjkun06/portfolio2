# Contact form email, sent through the IONOS mail server.
# Copy this file to .env.local for local testing, and add the same values on Vercel
# (Project → Settings → Environment Variables). Never commit the real password.

# IONOS SMTP server. Port 465 uses TLS; 587 uses STARTTLS.
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
# The mailbox that sends the form emails, and its password.
SMTP_USER=no-reply@frankjordan.dev
SMTP_PASS=
# Sender shown in your inbox (must be the SMTP_USER address).
MAIL_FROM="Frank Jordan website <no-reply@frankjordan.dev>"
# Where boarding passes are delivered.
MAIL_TO=frank@frankjordan.dev
